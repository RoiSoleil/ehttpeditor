<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!--
      The standalone EHttpEditor: a window with the editors of the HTTP files and the view of the responses, without
      the rest of the IDE.
   -->
   <extension id="application" point="org.eclipse.core.runtime.applications">
      <application visible="true">
         <run class="org.eclipse.ehttpeditor.app.HttpApplication"/>
      </application>
   </extension>

   <extension id="product" point="org.eclipse.core.runtime.products">
      <product
            application="org.eclipse.ehttpeditor.app.application"
            name="%productName">
         <property name="appName" value="%productName"/>
         <property name="windowImages"
               value="icons/ehttpeditor16.png,icons/ehttpeditor32.png,icons/ehttpeditor48.png,icons/ehttpeditor64.png,icons/ehttpeditor128.png,icons/ehttpeditor256.png"/>
         <property name="aboutImage" value="icons/ehttpeditor128.png"/>
         <property name="aboutText" value="%productBlurb"/>
         <property name="preferenceCustomization" value="plugin_customization.ini"/>
      </product>
   </extension>

   <extension point="org.eclipse.ui.perspectives">
      <perspective
            class="org.eclipse.ehttpeditor.app.HttpPerspective"
            icon="icons/ehttpeditor16.png"
            id="org.eclipse.ehttpeditor.app.perspective"
            name="%productName">
      </perspective>
   </extension>

   <!--
      The environment files (http-client.env.json, http-client.private.env.json) and the other JSON files: the
      Generic Editor, colored by TM4E.
   -->
   <extension point="org.eclipse.core.contenttype.contentTypes">
      <content-type
            id="json"
            base-type="org.eclipse.core.runtime.text"
            file-extensions="json"
            name="%contentType.json"
            priority="low"
            default-charset="UTF-8">
      </content-type>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <editorContentTypeBinding
            contentTypeId="org.eclipse.ehttpeditor.app.json"
            editorId="org.eclipse.ui.genericeditor.GenericEditor">
      </editorContentTypeBinding>
   </extension>

   <extension point="org.eclipse.tm4e.registry.grammars">
      <grammar
            scopeName="source.json.ehttpeditor"
            path="syntaxes/json.tmLanguage.json">
      </grammar>
      <scopeNameContentTypeBinding
            contentTypeId="org.eclipse.ehttpeditor.app.json"
            scopeName="source.json.ehttpeditor">
      </scopeNameContentTypeBinding>
   </extension>

   <extension point="org.eclipse.tm4e.languageconfiguration.languageConfigurations">
      <languageConfiguration
            contentTypeId="org.eclipse.ehttpeditor.app.json"
            path="language-configurations/json.language-configuration.json">
      </languageConfiguration>
   </extension>

   <!--
      File > New HTTP File..., File > Open File..., the menu Environments and Help > Documentation. The data of the
      class of EditEnvironmentHandler is the file it opens.
   -->
   <extension point="org.eclipse.ui.commands">
      <command
            id="org.eclipse.ehttpeditor.app.newFile"
            name="%command.newFile">
      </command>
      <command
            id="org.eclipse.ehttpeditor.app.openFile"
            name="%command.openFile">
      </command>
      <command
            id="org.eclipse.ehttpeditor.app.editEnvironments"
            name="%command.editEnvironments"
            description="%command.editEnvironments.description">
      </command>
      <command
            id="org.eclipse.ehttpeditor.app.editPrivateEnvironments"
            name="%command.editPrivateEnvironments"
            description="%command.editPrivateEnvironments.description">
      </command>
      <command
            id="org.eclipse.ehttpeditor.app.documentation"
            name="%command.documentation">
      </command>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            class="org.eclipse.ehttpeditor.app.NewFileHandler"
            commandId="org.eclipse.ehttpeditor.app.newFile">
      </handler>
      <handler
            class="org.eclipse.ehttpeditor.app.OpenFileHandler"
            commandId="org.eclipse.ehttpeditor.app.openFile">
      </handler>
      <handler
            class="org.eclipse.ehttpeditor.app.EditEnvironmentHandler:http-client.env.json"
            commandId="org.eclipse.ehttpeditor.app.editEnvironments">
      </handler>
      <handler
            class="org.eclipse.ehttpeditor.app.EditEnvironmentHandler:http-client.private.env.json"
            commandId="org.eclipse.ehttpeditor.app.editPrivateEnvironments">
      </handler>
      <handler
            class="org.eclipse.ehttpeditor.app.DocumentationHandler"
            commandId="org.eclipse.ehttpeditor.app.documentation">
      </handler>
   </extension>

   <!-- Ctrl+N is the New wizard of the workbench: only Open File has a key -->
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="org.eclipse.ehttpeditor.app.openFile"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+O">
      </key>
   </extension>

   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:file?after=open">
         <command commandId="org.eclipse.ehttpeditor.app.newFile" style="push"/>
         <command commandId="org.eclipse.ehttpeditor.app.openFile" style="push"/>
      </menuContribution>
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=edit">
         <menu id="environments" label="%menu.environments">
            <!-- The command of the plug-in, Ctrl+Alt+E in the HTTP editors -->
            <command
                  commandId="org.eclipse.ehttpeditor.commands.selectEnvironment"
                  icon="platform:/plugin/org.eclipse.ehttpeditor/icons/environment.png"
                  label="%command.selectEnvironment"
                  style="push"/>
            <separator name="edit" visible="true"/>
            <command commandId="org.eclipse.ehttpeditor.app.editEnvironments" style="push"/>
            <command commandId="org.eclipse.ehttpeditor.app.editPrivateEnvironments" style="push"/>
         </menu>
      </menuContribution>
      <menuContribution locationURI="menu:help?after=additions">
         <command commandId="org.eclipse.ehttpeditor.app.documentation" style="push"/>
      </menuContribution>
   </extension>

</plugin>
