<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.ehttpeditor</groupId>
		<artifactId>org.eclipse.ehttpeditor.releng</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../../releng</relativePath>
	</parent>
	<artifactId>org.eclipse.ehttpeditor.product</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>eclipse-repository</packaging>
	<!-- The standalone application, an archive by platform in target/products -->
	<build>
		<plugins>
			<!-- The p2 repository of the product is only the source of the archives -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<skipArchive>true</skipArchive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho.version}</version>
				<executions>
					<execution>
						<id>materialize-products</id>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<goals>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<products>
						<product>
							<id>org.eclipse.ehttpeditor.product</id>
							<archiveFileName>ehttpeditor</archiveFileName>
							<rootFolder>ehttpeditor</rootFolder>
							<rootFolders>
								<macosx>EHttpEditor.app</macosx>
							</rootFolders>
						</product>
					</products>
					<formats>
						<linux>tar.gz</linux>
						<macosx>tar.gz</macosx>
						<win32>zip</win32>
					</formats>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
